{
  "name": "pi-durable-subagents",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Durable Pi agents that collaborate asynchronously under explicit Owner and Spawner supervision.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "docs",
    "agents",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "benchmark:attached-terminal": "node benchmarks/attached-terminal-output.ts",
    "test": "npm run test:fast && npm run test:process",
    "test:fast": "node tests/support/run-test-suite.ts fast",
    "test:process": "node tests/support/run-test-suite.ts process",
    "test:conformance": "node tests/support/run-test-suite.ts conformance",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:repair": "npx tsx tests/support/run-repair-demo.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "24.10.1",
    "typebox": "1.3.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "node-pty": true
  }
}
